{
  "name": "dsh-better-skillmanager",
  "version": "1.0.2",
  "description": "Skills manager for DeepSeek Harness — list every installed skill with its official SkillHub name, uninstall it safely, and browse the market to install new ones. / 技能管理器：列出本机全部技能及其市场官方名称，安全卸载，并在市场里浏览安装。",
  "type": "module",
  "author": "Beishan",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skill",
    "skills",
    "skill-manager",
    "skillhub",
    "marketplace"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
