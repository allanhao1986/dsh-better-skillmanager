{
  "name": "dsh-better-skillmanager",
  "version": "1.3.2",
  "description": "Skills and MCP manager for DeepSeek Harness — list every installed skill with its official SkillHub name, switch it on or off, uninstall it safely, browse the market to install new ones, and inspect the MCP servers this process can reach. / 技能与 MCP 管理器：列出本机全部技能及其市场官方名称，可随时启用/停用、安全卸载，在市场里浏览安装，并查看本进程可用的 MCP 服务器。",
  "type": "module",
  "author": "Beishan",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skill",
    "skills",
    "skill-manager",
    "skillhub",
    "marketplace"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "dsh": "^0.2.1-rc.1",
    "node": ">=20"
  }
}
